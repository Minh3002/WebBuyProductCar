{
  "version": 2,
  "builds": [
    {
      "src": "mazlay-parts-api/src/main.ts", 
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:match*",
      "destination": "/mazlay-parts-api/src/main.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
